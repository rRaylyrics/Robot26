# 复制本文件为项目根目录的 .env，然后填写本地配置。
# .env 已被 Git 忽略。请将真实密钥仅保存在 .env 或环境变量中。

# 千问 AI 平台。真机运行时必须填写 API 密钥。
QWEN_API_KEY=
# 以下三项是程序默认值，可按账号开通的接口和模型调整。
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_VISION_MODEL=qwen3.8-flash

# Wall-X。真机运行时填写赛方下发的 WebSocket 地址和 API 密钥。
WALLX_MODEL_ADDRESS=
WALLX_API_KEY=
